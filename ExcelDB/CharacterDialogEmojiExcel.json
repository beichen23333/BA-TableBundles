    {
        "GroupId": -157935576,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": false,
        "LocalizeKR": "（需要保存收集到\n的数据。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -157935575,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": false,
        "LocalizeKR": "（已经保存了收集到\n的数据。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -157935574,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": false,
        "LocalizeKR": "（需要得到妮露的\n数据。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -157935573,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": false,
        "LocalizeKR": "（需要得到圣娅的\n数据。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（不动的时候应该\n不会被发现。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（看准时机……\n再行动吧。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933582,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "……哈……",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933582,
        "TargetIndex": 2,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "……啊……",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（再……\n一点……)",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933562,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "马上就到接头\n时间了。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933562,
        "TargetIndex": 2,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "赶紧交易完回去吧。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933562,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（……这样应该\n可以了吧。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933552,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（还有事情要做。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159933542,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（先稍微等等吧。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159931592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（听说继续往前\n走的话，会有数据\n装置，对吧？）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159931592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（说实话真想一路把\n它们全砸了……）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159931592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（……总之\n潜入这种事不是\n我的风格。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159931592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（体力下降的话……\n之前说过可以吃回复\n药来恢复。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159931582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（还有事要做。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（无人机……\n很有千禧年的风格\n呢，和崔尼蒂完全\n不一样。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（走到这条通道\n尽头……应该就会\n看到门了。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（机器狗……）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928582,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "圣娅，这边。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928582,
        "TargetIndex": 0,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "莉音？",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928582,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "机器狗上装了\n通信器。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928582,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "这样就能保存途中\n收集到的数据了。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928572,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（……这个地方\n过不去。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928572,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（得联系莉音\n才行。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928562,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "正好，我这边也在\n弄一条秘密通道。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928562,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "去操作配电盘，\n把换气扇关掉，然后\n从通风口过去就行。",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928552,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（这是……\n配电盘……？）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928542,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（这样一来，就能进\n通风口了。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -159928542,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（得赶紧移动\n才行。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158933592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（那是……？）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158933592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（这里也有啊。看来\n会很有用。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158933582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（在这里试着用一下\n吧……）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158933581,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（就是那个啊。性能\n确实不错。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（总之是到了……）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932592,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（再往里面走一点\n看看吧。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（想不被发现\n地接近，恐怕有点\n难。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（……我记得还有莉\n音给的护膝。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932582,
        "TargetIndex": 0,
        "DialogType": "Think",
        "Duration": 2500,
        "HideUI": true,
        "LocalizeKR": "（时机正好呢。）",
        "LocalizeJP": ""
    },
    {
        "GroupId": -158932572,
        "TargetIndex": 1,
        "DialogType": "Talk",
        "Duration": 2500,
        "HideUI": true,
